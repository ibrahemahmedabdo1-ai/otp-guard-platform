# ==== قاعدة البيانات (Neon.tech Postgres) ====
# لو سيبته فاضي، المشروع هيستخدم ملف data/db.json محليًا كبديل (فقط للتطوير)
# على Vercel لازم تحطه، لأن الملفات المحلية بتتمسح مع كل تشغيل serverless
# مثال: postgresql://user:password@ep-xxxx.neon.tech/dbname?sslmode=require
DATABASE_URL=

# ==== إعدادات عامة ====
PORT=3000
JWT_SECRET=change_this_to_a_long_random_secret
SESSION_SECRET=change_this_too

# مفتاح سري مؤقت لتشغيل /api/system/seed مرة واحدة بعد أول نشر على Vercel
# (احذفه من متغيرات البيئة بعد ما تستخدمه مرة واحدة)
SEED_SECRET=change_this_random_value

# ==== Twilio (SMS + WhatsApp Cloud alternative) ====
# احصل عليها من https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=            # رقم Twilio للـ SMS مثل +1234567890
TWILIO_WHATSAPP_FROM=       # رقم واتساب Twilio مثل whatsapp:+14155238886

# ==== IMS / أي بوابة SMS محلية بديلة (مثال: Unifonic, Msegat, Vonage) ====
IMS_API_URL=
IMS_API_KEY=
IMS_SENDER_NAME=

# ==== البريد الإلكتروني (Nodemailer / SMTP) ====
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="OTP Guard <no-reply@yourdomain.com>"

# ==== WhatsApp غير الرسمي عبر QR (whatsapp-web.js) ====
# لو استخدمت whatsapp-web.js بدل Twilio للربط بـ QR مباشرة من رقم حقيقي
WHATSAPP_SESSION_PATH=./data/wa-session

# ==== خدمة تحديد الدولة من الـ IP ====
GEO_IP_PROVIDER=http://ip-api.com/json/
